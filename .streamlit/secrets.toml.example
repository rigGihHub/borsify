# Lägg aldrig riktiga värden i GitHub. Kopiera endast dessa nyckelnamn till Streamlit Secrets.
APP_ACCESS_PASSWORD = "CHOOSE_A_STRONG_PASSWORD"
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY"

# Valfritt: aktiverar "Fråga Borsify AI" på varje rekommendation.
OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"
# Valfritt. Standard i appen är gpt-5.6-luna för låg kostnad.
OPENAI_MODEL = "gpt-5.6-luna"
